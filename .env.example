# Copy to .env. Replace the placeholder with a random token of at least 32 characters.
GATEWAY_TOKEN=replace-with-a-random-32-character-or-longer-token
HOST=127.0.0.1
PORT=3000
CLOUD_ENABLED=false
ORG_TERMS=幻想公司,演示项目
# No local URL means synthetic, offline demonstration, not model inference.
# LOCAL_URL=http://127.0.0.1:11434/v1/chat/completions
# LOCAL_MODEL=your-served-model
# LOCAL_API_KEY=
# Private LAN/sidecar endpoints require an exact administrator host allowlist.
# LOCAL_ALLOWED_HOSTS=host.docker.internal,model
# CLOUD_URL=https://your-provider.example/v1/chat/completions
# CLOUD_MODEL=your-pinned-model
# CLOUD_API_KEY=
# Optional advisory classifier on LOCAL_URL; never grants cloud access.
# CLASSIFIER_MODEL=your-local-classification-model

# Rust is the default core. Missing/broken Rust fails closed, never silently falls back.
PRIVACY_SCANNER=rust
# Explicit debugging alternative only: PRIVACY_SCANNER=typescript
# PRIVACY_SCANNER_BIN=/absolute/path/to/privacy-scanner
