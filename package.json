{
  "name": "privacy-handoff-gateway",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node dist/src/server.js",
    "dev": "node --import tsx src/server.ts",
    "build": "tsc --project tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "biome check src tests demo",
    "format": "biome check --write src tests demo",
    "test": "vitest run tests/unit.test.ts tests/provider.test.ts tests/scanner.test.ts",
    "attacks": "vitest run tests/attacks.test.ts tests/security-regression.test.ts",
    "verify": "vitest run tests/scenarios.test.ts",
    "test:all": "vitest run --exclude \"dist/**\"",
    "bench": "node --import tsx src/benchmark.ts",
    "rust:build": "cargo build --manifest-path rust-core/Cargo.toml --release --locked",
    "rust:test": "cargo test --manifest-path rust-core/Cargo.toml --locked",
    "personal": "node dist/src/personal.js"
  },
  "dependencies": {
    "@hono/node-server": "2.1.6",
    "hono": "4.13.16",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@types/node": "24.19.2",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  },
  "license": "SEE LICENSE IN LICENSES/Handoff-Community-1.0.txt"
}
