# macOS
.DS_Store

# Node.js dependencies and package-manager logs
node_modules/
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# TypeScript and build output
dist/
build/
coverage/
.nyc_output/
*.tsbuildinfo
.eslintcache
.prettiercache

# Framework and task-runner caches
.next/
.nuxt/
.vite/
.turbo/

# Local environment and secrets
.env
.env.*
!.env.example

# Local editor and OS files
.idea/
.claude-flow/
.omc/

# Local agent skills and their usage guide. Never committed, never published.
/.claude/
/.local/
skills-lock.json

# Experiment artifacts: raw transcripts stay local until the preprint lands.
bench/results/raw/
bench/results/*.jsonl
!bench/results/summary/**
bench/.ledger/
.venv*/
__pycache__/
*.egg-info/
